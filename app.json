{
  "expo": {
    "name": "Suivi Vétérinaire",
    "slug": "asv-vet",
    "version": "1.0.0",
    "scheme": "asv",
    "orientation": "portrait",
    "icon": "./assets/asv_icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/asv_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.melbedh.asvvet"
    },
    "web": {
      "favicon": "./assets/favicon_asv.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      ["expo-build-properties", {
        "android": {
          "usesCleartextTraffic": true
        }
      }]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1a8a4dbc-df46-44b1-8e32-b3b83412b6e6"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1a8a4dbc-df46-44b1-8e32-b3b83412b6e6"
    }
  }
}
